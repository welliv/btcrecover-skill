  "game_theory_router": {
    "description": "Selects optimal model based on task, cost, and privacy preferences.",
    "formula": "EV = (task_score × evidence_multiplier) - cost_penalty - risk_penalty",
    "variables": {
      "task_score": "Model's benchmark score for this recovery type (0-100)",
      "evidence_multiplier": {
        "HIGH": 1.0,
        "MEDIUM": 0.85,
        "LOW": 0.70
      },
      "cost_penalty": "(estimated_cost_usd / wallet_value_usd) × 20, capped at 20",
      "risk_penalty": {
        "tier1_offline": 0,
        "tier2_cloud_reasoning": 5,
        "tier3_full_online": 15
      }
    },
    "rules": [
      "If user prefers offline and has Ollama installed → use local model with highest task_score",
      "If task is forensics and cloud is acceptable → use Claude Opus 4 or qwen3:14b",
      "If task is password/seed and budget is constrained → use GPT-4o-mini or hermes3:8b",
      "If wallet value > $10,000 → prefer Tier 1 (offline) regardless of user preference",
      "Default → use Ollama hermes3:8b if available, else fallback to cloud"
    ]
  },
